logoutput: stderr
debug: 1
daemon: no
internal: 0.0.0.0 port = 1080

external: ${INTERFACE}

socksmethod: username
user.privileged: root
user.notprivileged: nobody

client pass {
    from: 0.0.0.0/0
    to: 0.0.0.0/0
}

socks pass {
    from: 0.0.0.0/0
    to: 0.0.0.0/0
    command: connect
    protocol: tcp udp
}
